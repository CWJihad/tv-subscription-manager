# Demo deployment. Keys only: never commit real values. Copy to .env on the demo server.
# The database name MUST contain "demo" (the nightly reseed wipes it and refuses any other name).

NODE_ENV=production
PORT=5000
BACKEND_IP=
# Number of reverse proxies in front of the app (nginx = 1). Needed for correct per-IP rate limits.
TRUST_PROXY=1

# Demo frontend URL only (CORS allow-list)
FRONTEND_URL=

MONGODB_URL=mongodb://127.0.0.1:27017/nigertoday-tv-demo


JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

APP_TIMEZONE=Asia/Dhaka
# Never set MOCK_TODAY here (the app refuses to start in production with it)
MOCK_TODAY=

# JOBS_ENABLED=true starts the nightly reseed. Reminders stay off in demo mode.
JOBS_ENABLED=true
REMINDERS_ENABLED=false
DEMO_MODE=true
DEMO_RESEED_HOUR=3
DEMO_MAX_CUSTOMERS=100

# Demo must use mock providers (the app refuses to start otherwise)
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# Demo owner login (share it privately, never on the login page)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FORCE=no
