{
  "apps": [
    {
      "name": "nigertoday-tv-api",
      "script": "src/index.js",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "400M",
      "kill_timeout": 10000,
      "time": true,
      "merge_logs": true,
      "out_file": "./logs/out.log",
      "error_file": "./logs/error.log",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}