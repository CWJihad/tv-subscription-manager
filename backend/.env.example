# Keys only. Never commit a real .env. Copy this file to .env and fill the blanks.

# ---- Server ----
NODE_ENV=development
PORT=5000
# Optional bind host. Leave empty to listen on all interfaces.
BACKEND_IP=
# Number of reverse proxies in front of the app (0 = none, 1 = Nginx on the VPS).
TRUST_PROXY=0
# Comma separated CORS allow-list.
FRONTEND_URL=http://localhost:3000

# ---- Database ----
MONGODB_URL=mongodb://127.0.0.1:27017/nigertoday-tv

# ---- Auth (required, no default) ----
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Business time ----
APP_TIMEZONE=Asia/Dhaka
# Dev only (the app refuses to start in production if set). The seed data assumes 2026-10-05.
MOCK_TODAY=

# ---- Reminder scheduler (node-cron runs inside the app: run ONE instance only) ----
JOBS_ENABLED=false
REMINDERS_ENABLED=false
# true = no outbound reminders at all (demo deployment).
DEMO_MODE=false

# ---- Email (mock = log only) ----
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- WhatsApp Cloud API (mock = log only) ----
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_NAME_EXPIRED=
WHATSAPP_TEMPLATE_LANG=en

# ---- Seeder (npm run seed) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Must be "yes" to seed when NODE_ENV=production.
SEED_FORCE=no